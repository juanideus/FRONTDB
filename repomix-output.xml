function SimpleQuery({ label, fetchFn }: { label: string; fetchFn: () => Promise<ApiResponse> }) {
    const [data, setData] = useState<unknown>(null);
    const [error, setError] = useState('');

    const run = async () => {
        setError(''); setData(null);
        const res = await fetchFn();
